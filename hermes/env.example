# ~/.hermes/.env  (Hermes Agent)      and      exeflow/.env (ExecFlow service)
GROQ_API_KEY=gsk_...
NOUS_API_KEY=...                 # only for model.provider: nous
API_SERVER_ENABLED=true
API_SERVER_KEY=change-me-local-dev
EXECFLOW_URL=http://127.0.0.1:8000
EXECFLOW_REPO=/path/to/exeflow

# ExecFlow service (exeflow/.env)
EXECFLOW_PROVIDER=groq           # groq | nous | openrouter | ollama | hermes | mock
EXECFLOW_MODEL_ANALYST=groq:openai/gpt-oss-120b
EXECFLOW_MODEL_REVIEWER=groq:openai/gpt-oss-20b
EXECFLOW_MODEL_REPORTER=groq:openai/gpt-oss-120b
# EXECFLOW_MODEL_REPORTER=hermes:hermes-agent    # route the report through Hermes so it uses Hermes memory
EXECFLOW_SEND_ROWS=false         # keep raw rows on the machine; only schema and aggregates go to the model
EXECFLOW_DATA=data
EXECFLOW_CORS=http://localhost:5173
