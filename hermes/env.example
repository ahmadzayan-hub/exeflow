# Optional Hermes CLI integration. Do not paste keys into source files.
# This template does not start Hermes, a gateway, monitoring, or cloud providers.
API_SERVER_ENABLED=false
EXECFLOW_URL=http://127.0.0.1:8000
EXECFLOW_REPO=/path/to/exeflow
EXECFLOW_API_TOKEN=

# ExecFlow service (exeflow/.env): offline synthetic demonstration by default.
EXECFLOW_MODE=mock
EXECFLOW_PROVIDER=mock
EXECFLOW_SEND_ROWS=false
EXECFLOW_DATA=data
EXECFLOW_CORS=http://localhost:5173
# The dashboard proxy is disabled, even when EXECFLOW_API_TOKEN is configured.
