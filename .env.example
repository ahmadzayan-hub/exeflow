# ExecFlow analytics service. Copy to .env (loaded by docker compose) or export in your shell.
EXECFLOW_PROVIDER=groq                 # groq | nous | openrouter | ollama | hermes | mock
GROQ_API_KEY=                          # https://console.groq.com  (leave empty to run the offline mock)
# NOUS_API_KEY=                        # Hermes 4 via Nous Portal
# OPENROUTER_API_KEY=
# API_SERVER_KEY=                      # when routing a role through a running Hermes Agent API server
EXECFLOW_MODEL_ANALYST=groq:openai/gpt-oss-120b
EXECFLOW_MODEL_REVIEWER=groq:openai/gpt-oss-20b
EXECFLOW_MODEL_REPORTER=groq:openai/gpt-oss-120b
EXECFLOW_SEND_ROWS=false               # raw rows never leave the machine unless true
EXECFLOW_DATA=data
EXECFLOW_CORS=http://localhost:5173
EXECFLOW_MAX_UPLOAD_MB=25
