# ExecFlow analytics: no paid or cloud execution. Copy to .env or export.
EXECFLOW_MODE=mock                    # mock (zero network) | local (loopback Ollama only)
EXECFLOW_PROVIDER=mock                # mock | ollama; cloud/Hermes providers are rejected
# Optional local setup (operator-managed server, cloud disabled, no outbound access):
# EXECFLOW_MODE=local
# EXECFLOW_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Per-role overrides must also be mock or local Ollama; old cloud overrides fail closed.
# EXECFLOW_MODEL_ANALYST=ollama:hermes3
# EXECFLOW_MODEL_REVIEWER=ollama:hermes3
# EXECFLOW_MODEL_REPORTER=ollama:hermes3
EXECFLOW_SEND_ROWS=false
EXECFLOW_DATA=data
EXECFLOW_CORS=http://localhost:5173
EXECFLOW_MAX_UPLOAD_MB=25

# Required runtime-only bearer token. Empty disables API access (503).
# Set a strong unique value yourself; never use a VITE_ variable or commit it.
EXECFLOW_API_TOKEN=
# The optional Hermes dashboard proxy is disabled in code, regardless of environment.
